# Copie este archivo a .env y complete los valores.

# Base de datos (docker-compose ya la configura con PostgreSQL)
DATABASE_URL=sqlite:///./leadflow.db

# Clave secreta que Zapier envía en el encabezado X-API-Key (invente una larga)
API_KEY=cambie-esto-por-una-clave-larga

# true = no llama a ningún servicio externo; solo registra lo que haría (para probar)
DRY_RUN=true

# URL pública de este servicio (para firmas de Twilio y estados de entrega). En Render se detecta sola.
PUBLIC_BASE_URL=https://su-servidor.ejemplo.com

# true = el servidor programa seguimientos, campañas diarias, conciliación y reporte semanal
SCHEDULER_ENABLED=true

# Claude (clasificación de respuestas)
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5-5
CLASSIFIER_EFFORT=low

# Lofty CRM
LOFTY_API_KEY=
LOFTY_BASE_URL=https://api.lofty.com/v1.0

# Proveedor de SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_LOOKUP_ENABLED=true

# BeenVerified (opcional)
BEENVERIFIED_API_KEY=
BEENVERIFIED_API_URL=

# Alertas: webhook de Slack o "Catch Hook" de Zapier (que puede reenviar por email)
ALERT_WEBHOOK_URL=

# Datos del agente que aparecen en los mensajes
AGENT_NAME=Daniel
AGENT_PHONE=
